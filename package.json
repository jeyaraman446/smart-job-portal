{
  "name": "job-portal-root",
  "version": "1.0.0",
  "description": "Smart Job Portal with Resume Matching (MERN Stack)",
  "scripts": {
    "dev": "node dev.js",
    "start": "node server/server.js",
    "build": "npm --prefix server install && npm --prefix client install --include=dev && npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.3.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.13",
    "pdf-parse": "^1.1.1"
  },
  "keywords": [
    "mern",
    "job-portal",
    "resume-matching",
    "mongodb",
    "react",
    "express",
    "node"
  ],
  "author": "Jeyaraman",
  "license": "ISC"
}
